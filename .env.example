# ATLAS Operational Database Configuration
# PostgreSQL + PostGIS Connection
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/atlas_db

# PostgreSQL Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=atlas_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Application Settings
ENVIRONMENT=development
ENABLE_POSTGIS=true
PORT=8000

# Groq AI Intelligence Layer (Backend Only)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=15.0

# Optional Sentinel Hub / Copernicus EO Browser OAuth (Leave blank if using public STAC + GIBS)
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=
